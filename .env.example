# Copy to .env and set your own values. .env is never committed.

# Path to the Google Earth Engine service account key (JSON), kept outside the repo.
# Initialise without project=: ee.Initialize(ee.ServiceAccountCredentials(client_email, GEE_KEY))
GEE_KEY=C:/path/to/gee-service-account.json

# Assistant screen (server route /api/assistant). Optional: without it the screen says it is not configured.
ANTHROPIC_API_KEY=
