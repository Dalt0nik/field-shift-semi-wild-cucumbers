# Copy to .env and set your own values. .env is never committed.

# Path to the Google Earth Engine service account key (JSON), kept outside the repo.
# Initialise without project=: ee.Initialize(ee.ServiceAccountCredentials(client_email, GEE_KEY))
GEE_KEY=C:/path/to/gee-service-account.json

# Copernicus Data Space (CDSE) S3 credentials, for Copernicus HRL Crop Types (crop history 2017–2024).
# Create a free account at https://dataspace.copernicus.eu, then make the keys at
# https://eodata-s3keysmanager.dataspace.copernicus.eu/ (Add Credentials; the secret is shown only once).
# Endpoint: https://eodata.dataspace.copernicus.eu. Needed only to rebuild the data (pipeline/).
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# Assistant screen (server route /api/assistant). Optional: without it the screen says it is not configured.
ANTHROPIC_API_KEY=
